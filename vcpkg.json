{
  "dependencies": [
    "boost-geometry",
    "boost-iostreams",
    "boost-program-options",
    {
      "name": "bullet3",
      "features": [
        "double-precision",
        "multithreading"
      ]
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale"
      ],
      "platform": "android | ios"
    },
    {
      "name": "ffmpeg",
      "platform": "!android & !ios"
    },
    "freetype",
    "icu",
    "luajit",
    "lz4",
    {
      "name": "mygui",
      "platform": "!osx"
    },
    "openal-soft",
    {
      "name": "openmw-mygui-osx",
      "platform": "osx"
    },
    "openmw-osg",
    "sdl2",
    {
      "name": "unshield",
      "platform": "osx"
    }
  ]
}
