{
  "name": "openmw-osg",
  "version-date": "2026-01-30",
  "port-version": 1,
  "description": "Fork of OpenSceneGraph for OpenMW-specific performance improvements.",
  "homepage": "https://github.com/openmw/osg",
  "license": null,
  "supports": "!uwp",
  "dependencies": [
    "collada-dom",
    {
      "name": "freetype",
      "default-features": false,
      "features": [
        "bzip2",
        "png",
        "zlib"
      ],
      "platform": "android | ios"
    },
    {
      "name": "freetype",
      "platform": "!android & !ios"
    },
    {
      "name": "glad",
      "platform": "android",
      "features": [
        "gles2-api-latest"
      ]
    },
    "libiconv",
    "libjpeg-turbo",
    "libpng",
    "libxml2",
    "opengl-registry",
    "tiff",
    "zlib",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
